<script>
  import '@tdgs/core/elements';
  import { toast, type ToastVariant } from '@tdgs/core/elements';

  const messages: Record<ToastVariant, string> = {
    success: 'Dossier enregistré — référence REF-2024-001234',
    info: 'Brouillon sauvegardé automatiquement',
    warning: 'Certaines pièces jointes sont trop lourdes',
    danger: 'La connexion a échoué, réessayez',
  };

  document.querySelectorAll<HTMLElement>('[data-toast]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const variant = (btn.dataset.toast ?? 'info') as ToastVariant;
      toast(messages[variant] ?? 'Notification', { variant });
    });
  });

  document.getElementById('consent-reset')?.addEventListener('click', () => {
    localStorage.removeItem('tds-consent');
    location.reload();
  });
</script>
