---
// Terrain de jeu visuel : rend chaque variante/taille/état de chaque composant
// avec le CSS réellement buildé de @tdgs/core (copié dans public/tds/ par
// scripts/copy-core-assets.mjs). Sert de QA visuelle rapide — remplace le
// placeholder apps/storybook, qui n'apportait rien pour une bibliothèque
// 100% CSS sans état/props JS à piloter.
const buttonVariants = ['primary', 'secondary', 'tertiary', 'danger', 'success'];
const buttonSizes = ['sm', 'md', 'lg'];
const inputVariants = ['default', 'error', 'success'];
const badgeVariants = ['default', 'info', 'success', 'warning', 'danger'];
const alertVariants = ['info', 'success', 'warning', 'danger'];
const cardVariants = ['flat', 'elevated', 'outlined'];
const linkVariants = ['default', 'muted', 'danger', 'external', 'nav', 'standalone'];
const breadcrumbTrail = [
  { label: 'Accueil', href: '#' },
  { label: 'Démarches', href: '#' },
  { label: 'Renouvellement de carte' },
];
const paginationPages = [1, 2, 3, 4, 5];
const calloutVariants = ['neutral', 'info', 'success', 'warning', 'danger'];
const noticeVariants = ['info', 'success', 'warning', 'danger'];
const tagVariants = ['default', 'info', 'success', 'warning', 'danger'];
const summaryItems = [
  { label: 'Présentation', href: '#callout' },
  { label: 'Règles d’accessibilité', href: '#notice' },
  { label: 'Ressources', href: '#download' },
];
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <title>TDGS — Terrain de jeu des composants</title>
  <link rel="stylesheet" href="/tds/base.css" />
  <link rel="stylesheet" href="/tds/tokens/color.css" />
  <link rel="stylesheet" href="/tds/tokens/typography.css" />
  <link rel="stylesheet" href="/tds/tokens/spacing.css" />
  <link rel="stylesheet" href="/tds/tokens/radius.css" />
  <link rel="stylesheet" href="/tds/tokens/shadow.css" />
  <link rel="stylesheet" href="/tds/tokens/motion.css" />
  <link rel="stylesheet" href="/tds/tokens/z-index.css" />
  <link rel="stylesheet" href="/tds/components/button/button.css" />
  <link rel="stylesheet" href="/tds/components/input/input.css" />
  <link rel="stylesheet" href="/tds/components/alert/alert.css" />
  <link rel="stylesheet" href="/tds/components/badge/badge.css" />
  <link rel="stylesheet" href="/tds/components/card/card.css" />
  <link rel="stylesheet" href="/tds/components/link/link.css" />
  <link rel="stylesheet" href="/tds/components/table/table.css" />
  <link rel="stylesheet" href="/tds/components/header/header.css" />
  <link rel="stylesheet" href="/tds/components/nav/nav.css" />
  <link rel="stylesheet" href="/tds/components/breadcrumb/breadcrumb.css" />
  <link rel="stylesheet" href="/tds/components/pagination/pagination.css" />
  <link rel="stylesheet" href="/tds/components/modal/modal.css" />
  <link rel="stylesheet" href="/tds/components/skip-link/skip-link.css" />
  <link rel="stylesheet" href="/tds/components/footer/footer.css" />
  <link rel="stylesheet" href="/tds/components/accordion/accordion.css" />
  <link rel="stylesheet" href="/tds/components/tabs/tabs.css" />
  <link rel="stylesheet" href="/tds/components/tooltip/tooltip.css" />
  <link rel="stylesheet" href="/tds/components/search/search.css" />
  <link rel="stylesheet" href="/tds/components/stepper/stepper.css" />
  <link rel="stylesheet" href="/tds/components/file-upload/file-upload.css" />
  <link rel="stylesheet" href="/tds/components/progress/progress.css" />
  <link rel="stylesheet" href="/tds/components/callout/callout.css" />
  <link rel="stylesheet" href="/tds/components/notice/notice.css" />
  <link rel="stylesheet" href="/tds/components/tag/tag.css" />
  <link rel="stylesheet" href="/tds/components/tile/tile.css" />
  <link rel="stylesheet" href="/tds/components/download/download.css" />
  <link rel="stylesheet" href="/tds/components/quote/quote.css" />
  <link rel="stylesheet" href="/tds/components/summary/summary.css" />
  <link rel="stylesheet" href="/tds/components/password/password.css" />
  <link rel="stylesheet" href="/tds/components/range/range.css" />
  <link rel="stylesheet" href="/tds/components/segmented/segmented.css" />
  <link rel="stylesheet" href="/tds/components/dropdown/dropdown.css" />
  <link rel="stylesheet" href="/tds/components/sidemenu/sidemenu.css" />
  <link rel="stylesheet" href="/tds/components/share/share.css" />
  <link rel="stylesheet" href="/tds/components/logo/logo.css" />
  <link rel="stylesheet" href="/tds/components/toast/toast.css" />
  <link rel="stylesheet" href="/tds/components/consent/consent.css" />
  <link rel="stylesheet" href="/tds/icons/icons.css" />
  <style>
    body {
      max-width: 72rem;
      margin: 0 auto;
      padding: var(--tds-spacing-8);
      font-family: var(--tds-font-family-primary);
      background: var(--tds-bg);
      color: var(--tds-text);
    }
    section { margin-bottom: var(--tds-spacing-16); scroll-margin-top: var(--tds-spacing-6); }
    h2 { border-bottom: 1px solid var(--tds-border-subtle); padding-bottom: var(--tds-spacing-2); }
    .row { display: flex; flex-wrap: wrap; align-items: center; gap: var(--tds-spacing-4); margin-bottom: var(--tds-spacing-4); }
    .row-label { width: 8rem; font-size: var(--tds-font-size-sm); color: var(--tds-text-muted); }
  </style>
</head>
<body>
<main>
  <h1>TDGS — Terrain de jeu des composants</h1>
  <p>Rend chaque variante × taille × état à partir du CSS réellement buildé (<code>packages/core/dist</code>). Page de QA visuelle, non indexée, non liée depuis la navigation Starlight.</p>

  <section id="button" data-pagefind-ignore>
    <h2>Button</h2>
    {buttonSizes.map((size) => (
      <div class="row">
        <span class="row-label">{size}</span>
        {buttonVariants.map((variant) => (
          <button type="button" class={`tds-button tds-button--${variant} tds-button--${size}`}>
            {variant}
          </button>
        ))}
      </div>
    ))}
    <div class="row">
      <span class="row-label">disabled</span>
      <button type="button" class="tds-button tds-button--primary tds-button--md" disabled>primary</button>
      <button type="button" class="tds-button tds-button--secondary tds-button--md" aria-disabled="true">secondary</button>
    </div>
    <div class="row">
      <span class="row-label">loading</span>
      <button type="button" class="tds-button tds-button--primary tds-button--md" data-loading="true">Envoi…</button>
    </div>
  </section>

  <section id="input" data-pagefind-ignore>
    <h2>Input</h2>
    {['sm', 'md', 'lg'].map((size) => (
      <div class="row">
        <span class="row-label">{size}</span>
        {inputVariants.map((variant) => (
          <div class="tds-field">
            <label class="tds-field__label" for={`input-${size}-${variant}`}>{variant}</label>
            <input id={`input-${size}-${variant}`} type="text" class={`tds-input tds-input--${size} ${variant !== 'default' ? `tds-input--${variant}` : ''}`} placeholder="Texte…" />
          </div>
        ))}
      </div>
    ))}
    <div class="row">
      <span class="row-label">disabled</span>
      <div class="tds-field">
        <label class="tds-field__label" for="input-disabled">Champ désactivé</label>
        <input id="input-disabled" type="text" class="tds-input tds-input--md tds-input--disabled" value="Champ désactivé" disabled />
      </div>
      <div class="tds-field">
        <label class="tds-field__label" for="input-readonly">Lecture seule</label>
        <input id="input-readonly" type="text" class="tds-input tds-input--md tds-input--readonly" value="Lecture seule" readonly />
      </div>
    </div>
  </section>

  <section id="alert" data-pagefind-ignore>
    <h2>Alert</h2>
    {alertVariants.map((variant) => (
      <div class={`tds-alert tds-alert--${variant}`} role="status" style="margin-bottom: var(--tds-spacing-3);">
        <div class="tds-alert__content">
          <p class="tds-alert__title">Titre {variant}</p>
          <div class="tds-alert__body">Message d'exemple pour la variante {variant}.</div>
        </div>
      </div>
    ))}
  </section>

  <section id="badge" data-pagefind-ignore>
    <h2>Badge</h2>
    {['sm', 'md'].map((size) => (
      <div class="row">
        <span class="row-label">{size}</span>
        {badgeVariants.map((variant) => (
          <span class={`tds-badge tds-badge--${variant} tds-badge--${size}`}>{variant}</span>
        ))}
      </div>
    ))}
  </section>

  <section id="card" data-pagefind-ignore>
    <h2>Card</h2>
    <div class="row">
      {cardVariants.map((variant) => (
        <div class={`tds-card tds-card--${variant}`} style="width: 16rem;">
          <div class="tds-card__body">
            <p class="tds-card__title">Carte {variant}</p>
            <p class="tds-card__description">Contenu d'exemple pour la variante {variant}.</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section id="link" data-pagefind-ignore>
    <h2>Link</h2>
    <div class="row">
      {linkVariants.map((variant) => (
        <a href="#" class={`tds-link ${variant !== 'default' ? `tds-link--${variant}` : ''}`}>Lien {variant}</a>
      ))}
    </div>
  </section>

  <section id="table" data-pagefind-ignore>
    <h2>Table</h2>
    <div class="tds-table-wrapper">
      <table class="tds-table tds-table--striped tds-table--bordered">
        <caption>Exemple de tableau strié et bordé</caption>
        <thead>
          <tr><th scope="col">Référence</th><th scope="col">Statut</th><th scope="col">Montant</th></tr>
        </thead>
        <tbody>
          <tr><td>REF-001</td><td data-status="success">Validé</td><td>12 400 FCFA</td></tr>
          <tr><td>REF-002</td><td data-status="warning">En attente</td><td>8 000 FCFA</td></tr>
          <tr><td>REF-003</td><td data-status="danger">Rejeté</td><td>3 200 FCFA</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section id="header" data-pagefind-ignore>
    <h2>Header</h2>
    <div class="tds-header" style="border: 1px solid var(--tds-neutral-200); margin-bottom: var(--tds-spacing-3);">
      <a href="#" class="tds-header__brand">
        <div class="tds-header__titles">
          <span class="tds-header__title">TDGS — Exemple public tchadien</span>
          <span class="tds-header__tagline">Service numérique de démonstration</span>
        </div>
      </a>
      <div class="tds-header__actions">
        <a href="#" class="tds-link">Se connecter</a>
      </div>
    </div>
    <div class="tds-header tds-header--compact" style="border: 1px solid var(--tds-neutral-200);">
      <a href="#" class="tds-header__brand">
        <span class="tds-header__title">Variante compacte</span>
      </a>
    </div>
  </section>

  <section id="nav" data-pagefind-ignore>
    <h2>Navigation</h2>
    <nav class="tds-nav" aria-label="Navigation principale" style="margin-bottom: var(--tds-spacing-3);">
      <ul class="tds-nav__list">
        <li><a href="#" class="tds-nav__link" aria-current="page">Accueil</a></li>
        <li><a href="#" class="tds-nav__link">Démarches</a></li>
        <li><a href="#" class="tds-nav__link">Services</a></li>
        <li><a href="#" class="tds-nav__link">Contact</a></li>
      </ul>
    </nav>
    <nav class="tds-nav tds-nav--muted" aria-label="Navigation secondaire">
      <ul class="tds-nav__list">
        <li><a href="#" class="tds-nav__link">Sous-section A</a></li>
        <li><a href="#" class="tds-nav__link" aria-current="page">Sous-section B</a></li>
      </ul>
    </nav>
  </section>

  <section id="breadcrumb" data-pagefind-ignore>
    <h2>Breadcrumb</h2>
    <nav class="tds-breadcrumb" aria-label="Fil d'Ariane">
      <ol class="tds-breadcrumb__list">
        {breadcrumbTrail.map((item) => (
          <li class="tds-breadcrumb__item">
            {item.href
              ? <a href={item.href} class="tds-breadcrumb__link">{item.label}</a>
              : <span class="tds-breadcrumb__current" aria-current="page">{item.label}</span>}
          </li>
        ))}
      </ol>
    </nav>
  </section>

  <section id="pagination" data-pagefind-ignore>
    <h2>Pagination</h2>
    <nav aria-label="Pagination">
      <ul class="tds-pagination__list">
        <li><a href="#" class="tds-pagination__link" aria-disabled="true" aria-label="Page précédente">‹</a></li>
        {paginationPages.map((page) => (
          <li><a href="#" class="tds-pagination__link" aria-current={page === 1 ? 'page' : undefined} aria-label={`Page ${page}`}>{page}</a></li>
        ))}
        <li><span class="tds-pagination__ellipsis">…</span></li>
        <li><a href="#" class="tds-pagination__link" aria-label="Page 12">12</a></li>
        <li><a href="#" class="tds-pagination__link" aria-label="Page suivante">›</a></li>
      </ul>
    </nav>
  </section>

  <section id="modal" data-pagefind-ignore>
    <h2>Modal</h2>
    <p>Rendu statique (attribut <code>open</code>) pour la QA visuelle — l'ouverture réelle passe par <code>dialog.showModal()</code> côté consommateur.</p>
    <dialog class="tds-modal" open style="position: static; margin: 0;">
      <div class="tds-modal__header">
        <h3 class="tds-modal__title">Confirmer la soumission</h3>
        <button type="button" class="tds-modal__close" aria-label="Fermer">✕</button>
      </div>
      <div class="tds-modal__body">
        <p>Votre demande sera transmise au service concerné. Cette action est définitive.</p>
      </div>
      <div class="tds-modal__footer">
        <button type="button" class="tds-button tds-button--tertiary tds-button--md">Annuler</button>
        <button type="button" class="tds-button tds-button--primary tds-button--md">Confirmer</button>
      </div>
    </dialog>
  </section>

  <section id="skip-link" data-pagefind-ignore>
    <h2>Skip Link</h2>
    <p>Invisible par défaut, apparaît uniquement au focus clavier (Tab). Cliquez/tabulez dans le cadre ci-dessous pour le révéler.</p>
    <div style="position: relative; height: 4.5rem; border: 1px dashed var(--tds-neutral-300); overflow: hidden;">
      <a href="#skip-link" class="tds-skip-link">Aller au contenu principal</a>
    </div>
  </section>

  <section id="footer" data-pagefind-ignore>
    <h2>Footer</h2>
    <footer class="tds-footer">
      <div class="tds-footer__top">
        <div class="tds-footer__brand">
          <span style="color: var(--tds-neutral-0); font-weight: var(--tds-font-weight-semibold);">Tchad Design System</span>
        </div>
        <nav class="tds-footer__nav" aria-label="Liens du pied de page">
          <div class="tds-footer__nav-group">
            <div class="tds-footer__nav-title">Ressources</div>
            <a href="#" class="tds-footer__link">Documentation</a>
            <a href="#" class="tds-footer__link">GitHub</a>
          </div>
          <div class="tds-footer__nav-group">
            <div class="tds-footer__nav-title">Légal</div>
            <a href="#" class="tds-footer__link">Mentions légales</a>
            <a href="#" class="tds-footer__link">Accessibilité</a>
          </div>
        </nav>
      </div>
      <div class="tds-footer__bottom">
        <span>© 2026 TDGS — exemple de démonstration</span>
        <div class="tds-footer__legal">
          <a href="#" class="tds-footer__link">Confidentialité</a>
          <a href="#" class="tds-footer__link">Plan du site</a>
        </div>
      </div>
    </footer>
  </section>

  <section id="accordion" data-pagefind-ignore>
    <h2>Accordion</h2>
    <div class="tds-accordion">
      <details class="tds-accordion__item" open>
        <summary class="tds-accordion__trigger">
          Quels documents sont nécessaires ?
          <svg class="tds-accordion__icon" aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6l4 4 4-4" /></svg>
        </summary>
        <div class="tds-accordion__content">Carte d'identité, justificatif de domicile de moins de 3 mois, et photo d'identité récente.</div>
      </details>
      <details class="tds-accordion__item">
        <summary class="tds-accordion__trigger">
          Quel est le délai de traitement ?
          <svg class="tds-accordion__icon" aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6l4 4 4-4" /></svg>
        </summary>
        <div class="tds-accordion__content">Le traitement standard prend entre 5 et 10 jours ouvrés.</div>
      </details>
    </div>
  </section>

  <section id="tabs" data-pagefind-ignore>
    <h2>Tabs</h2>
    <div>
      <div class="tds-tabs__list" role="tablist" aria-label="Exemple d'onglets">
        <button type="button" class="tds-tabs__trigger" role="tab" aria-selected="true" aria-controls="panel-1" id="tab-1">Aperçu</button>
        <button type="button" class="tds-tabs__trigger" role="tab" aria-selected="false" aria-controls="panel-2" id="tab-2" tabindex="-1">Documents</button>
        <button type="button" class="tds-tabs__trigger" role="tab" aria-selected="false" aria-controls="panel-3" id="tab-3" tabindex="-1">Historique</button>
      </div>
      <div class="tds-tabs__panel" role="tabpanel" id="panel-1" aria-labelledby="tab-1">Contenu de l'onglet Aperçu.</div>
      <div class="tds-tabs__panel" role="tabpanel" id="panel-2" aria-labelledby="tab-2" hidden>Contenu de l'onglet Documents.</div>
      <div class="tds-tabs__panel" role="tabpanel" id="panel-3" aria-labelledby="tab-3" hidden>Contenu de l'onglet Historique.</div>
    </div>
  </section>

  <section id="tooltip" data-pagefind-ignore>
    <h2>Tooltip</h2>
    <div class="row" style="padding-top: var(--tds-spacing-8); padding-bottom: var(--tds-spacing-4);">
      <span class="tds-tooltip" tabindex="0" aria-describedby="tooltip-1">
        Survoler ou tabuler ici
        <span class="tds-tooltip__bubble" id="tooltip-1" role="tooltip">Information contextuelle complémentaire</span>
      </span>
    </div>
  </section>

  <section id="search" data-pagefind-ignore>
    <h2>Recherche</h2>
    <form class="tds-search" role="search">
      <label class="tds-search__label" for="playground-search">Rechercher un service</label>
      <div class="tds-search__controls">
        <input id="playground-search" class="tds-search__input" type="search" placeholder="Ex. carte nationale d'identité" />
        <button type="submit" class="tds-search__submit">Rechercher</button>
      </div>
    </form>
  </section>

  <section id="stepper" data-pagefind-ignore>
    <h2>Étapes</h2>
    <nav aria-label="Étapes de la demande">
      <ol class="tds-stepper">
        <li class="tds-stepper__item tds-stepper--complete">
          <span class="tds-stepper__marker" aria-hidden="true">✓</span>
          <span class="tds-stepper__content"><span class="tds-stepper__label">Identité</span><span class="tds-stepper__description">Terminée</span></span>
        </li>
        <li class="tds-stepper__item tds-stepper--current" aria-current="step">
          <span class="tds-stepper__marker" aria-hidden="true">2</span>
          <span class="tds-stepper__content"><span class="tds-stepper__label">Documents</span><span class="tds-stepper__description">Étape en cours</span></span>
        </li>
        <li class="tds-stepper__item tds-stepper--upcoming">
          <span class="tds-stepper__marker" aria-hidden="true">3</span>
          <span class="tds-stepper__content"><span class="tds-stepper__label">Confirmation</span></span>
        </li>
      </ol>
    </nav>
  </section>

  <section id="file-upload" data-pagefind-ignore>
    <h2>Dépôt de fichier</h2>
    <div class="tds-file-upload">
      <label class="tds-field__label" for="playground-file">Justificatif</label>
      <input id="playground-file" class="tds-file-upload__input" type="file" accept="application/pdf,image/*" />
      <label class="tds-file-upload__label" for="playground-file">
        <span class="tds-file-upload__choose">Choisir un fichier</span>
        <span>PDF ou image, 5 Mo maximum.</span>
      </label>
    </div>
  </section>

  <section id="progress" data-pagefind-ignore>
    <h2>Progression</h2>
    <div class="tds-progress">
      <div class="tds-progress__label" id="playground-progress-label"><span>Traitement de la demande</span><span aria-hidden="true">65 %</span></div>
      <div class="tds-progress__track" role="progressbar" aria-labelledby="playground-progress-label" aria-valuemin="0" aria-valuemax="100" aria-valuenow="65">
        <div class="tds-progress__indicator" style="--tds-progress-value: 65%"></div>
      </div>
    </div>
    <div class="tds-progress tds-progress--indeterminate" aria-label="Chargement des données" style="margin-top: var(--tds-spacing-4);">
      <div class="tds-progress__track" role="progressbar" aria-label="Chargement des données"><div class="tds-progress__indicator"></div></div>
    </div>
  </section>

  <section id="callout" data-pagefind-ignore>
    <h2>Callout</h2>
    {calloutVariants.map((variant) => (
      <aside class={`tds-callout tds-callout--${variant}`} style="margin-bottom: var(--tds-spacing-3);">
        <div class="tds-callout__content">
          <h3 class="tds-callout__title">Information {variant}</h3>
          <div class="tds-callout__body">Conseil éditorial ou explication utile à la démarche.</div>
        </div>
      </aside>
    ))}
  </section>

  <section id="notice" data-pagefind-ignore>
    <h2>Notice</h2>
    {noticeVariants.map((variant) => (
      <div class={`tds-notice tds-notice--${variant}`} role={variant === 'danger' ? 'alert' : 'status'} style="margin-bottom: var(--tds-spacing-3);">
        <div class="tds-notice__content">
          <span class="tds-notice__title">Bandeau {variant}</span>
          <div class="tds-notice__body">Information prioritaire visible dans le contexte de la page.</div>
        </div>
        <button type="button" class="tds-notice__close" aria-label="Masquer ce bandeau"><span aria-hidden="true">×</span></button>
      </div>
    ))}
  </section>

  <section id="tag" data-pagefind-ignore>
    <h2>Tag</h2>
    <div class="row">
      {tagVariants.map((variant) => (
        <span class={`tds-tag tds-tag--${variant} tds-tag--md`}>
          <span class="tds-tag__dot" aria-hidden="true"></span>
          {variant}
        </span>
      ))}
