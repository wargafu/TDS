---
import { getCollection, render } from 'astro:content';
import DocLayout from '../layouts/DocLayout.astro';
import { mdxComponents } from '../components/mdx';

export async function getStaticPaths() {
  const entries = await getCollection('docs');
  return entries
    .filter((entry) => entry.id !== 'index' && entry.id !== '404' && !entry.data.draft)
    .map((entry) => {
      const slug = entry.id.replace(/\/index$/, '');
      return { params: { slug: slug || undefined }, props: { entry } };
    });
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
// L'identifiant de collection (ex. `fondamentaux/index`) est la clé utilisée
// par lib/navigation.ts — ne pas retirer `/index` ici, sinon les pages
// d'accueil de section perdent leur barre latérale.
---

<DocLayout
  slug={entry.id}
  title={entry.data.title}
  description={entry.data.description}
  headings={headings}
  template={entry.data.template}
  tableOfContents={entry.data.tableOfContents}
  badge={entry.data.badge}
  editPath={(entry.filePath ?? `src/content/docs/${entry.id}.mdx`).replace(/^.*src\/content\/docs\//, '')}
>
  <Content components={mdxComponents} />
</DocLayout>
