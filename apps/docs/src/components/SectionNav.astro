---
// Barre horizontale des sections TDGS, sous le header principal.
// Calquée sur l'organisation de la navigation DSFR : les items avec
// sous-menu sont des boutons (aria-expanded + aria-controls), les items
// simples des liens. Le panneau affiche les rubriques en colonnes.
import { SECTION_PREFIXES } from './section-prefixes';

// eslint-disable-next-line @typescript-eslint/no-explicit-any
const { sidebar } = (Astro.locals as any).starlightRoute;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const pathname = Astro.url.pathname;

type SectionEntry = {
  type: 'link' | 'group';
  label: string;
  href?: string;
  entries?: SectionEntry[];
};
type MenuSection = { label: string; links: SectionEntry[] };
type MenuColumn = { sections: MenuSection[] };

const groups = sidebar.filter((entry: SectionEntry) => entry.type === 'group') as SectionEntry[];

// Répartit les rubriques d'un menu en 1 à 3 colonnes équilibrées (par nombre
// de liens), pour éviter un panneau trop large ou surchargé.
const getMenuColumns = (entries: SectionEntry[]): MenuColumn[] => {
  const sections: MenuSection[] = [];
  const directLinks = entries.filter((entry) => entry.type === 'link');
  if (directLinks.length) sections.push({ label: '', links: directLinks });
  entries
    .filter((entry) => entry.type === 'group')
    .forEach((group) => sections.push({ label: group.label, links: group.entries ?? [] }));

  const MAX_COLUMNS = 3;
  const columns: MenuSection[][] = Array.from({ length: MAX_COLUMNS }, () => []);
  for (const section of sections) {
    const target = columns
      .map((col, i) => ({ i, count: col.reduce((n, s) => n + s.links.length, 0) }))
      .sort((a, b) => a.count - b.count)[0].i;
    columns[target].push(section);
  }
  return columns.map((col) => ({ sections: col }));
};

const activeIndex = groups.findIndex((_group: unknown, i: number) => {
  const prefix = SECTION_PREFIXES[i];
  return prefix && pathname.includes(`/${prefix}/`);
});

// Compare deux chemins sans tenir compte du slash final.
const normalizePath = (href: string) => href.replace(/\/+$/, '');
const isCurrentLink = (href?: string) =>
  Boolean(href) && normalizePath(href) === normalizePath(pathname);
---

<nav class="tds-section-nav print:hidden" aria-label="Sections de la documentation">
  <ul class="tds-section-nav__list">
    {
      groups.map((group, i: number) => {
        const prefix = SECTION_PREFIXES[i];
        const href = `${base}${prefix}/`;
        const isActive = i === activeIndex;
        const hasMenu = Boolean(group.entries?.length);
        const menuId = `tds-nav-menu-${i}`;

        return (
          <li class:list={['tds-section-nav__item', { 'is-active': isActive, 'has-menu': hasMenu }]}>
            {hasMenu ? (
              <>
                <button
                  type="button"
                  class="tds-section-nav__btn"
                  aria-expanded="false"
                  aria-controls={menuId}
                  aria-current={isActive ? 'page' : undefined}
                >
                  <span class="tds-section-nav__label">{group.label}</span>
                  <span class="tds-section-nav__caret" aria-hidden="true">▾</span>
                </button>
                <div class="tds-section-nav__panel" id={menuId}>
                  <div class="tds-section-nav__panel-inner">
                    <div class="tds-section-nav__panel-header">
                      <span>{group.label}</span>
                      <a href={href}>Voir toute la section <span aria-hidden="true">→</span></a>
                    </div>
                    <div class="tds-section-nav__columns">
                      {getMenuColumns(group.entries).map((column) => (
                        <div class="tds-section-nav__column">
                          {column.sections.map((section) => (
                            <div class="tds-section-nav__section">
                              {section.label && (
                                <p class="tds-section-nav__section-title">{section.label}</p>
                              )}
                              <ul>
                                {section.links.map(
                                  (entry) =>
                                    entry.type === 'link' &&
                                    entry.href && (
                                      <li>
                                        <a
                                          href={entry.href}
                                          aria-current={isCurrentLink(entry.href) ? 'page' : undefined}
                                          class:list={{ 'is-current': isCurrentLink(entry.href) }}
                                        >
                                          {entry.label}
                                        </a>
                                      </li>
                                    )
                                )}
                              </ul>
                            </div>
                          ))}
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              </>
            ) : (
              <a href={href} class="tds-section-nav__link" aria-current={isActive ? 'page' : undefined}>
                {group.label}
              </a>
            )}
          </li>
        );
      })
    }
  </ul>
</nav>

<script is:inline>
  (() => {
    const nav = document.querySelector('.tds-section-nav');
    if (!nav) return;

    const items = [...nav.querySelectorAll(':scope > ul > li')];
    const itemsWithMenu = [...nav.querySelectorAll('.has-menu')];
    const getTrigger = (item) =>
      item.querySelector(':scope > button') ?? item.querySelector(':scope > a');
    const setExpanded = (item, value) =>
      getTrigger(item)?.setAttribute('aria-expanded', String(value));

    const closeItems = (exceptItem = null) => {
      itemsWithMenu.forEach((item) => {
        if (item === exceptItem) return;
        item.classList.remove('is-open');
        setExpanded(item, false);
      });
    };
    const openItem = (item) => {
      closeItems(item);
      item.classList.add('is-open');
      setExpanded(item, true);
    };
    const closeItem = (item) => {
      item.classList.remove('is-open');
      setExpanded(item, false);
    };

    itemsWithMenu.forEach((item) => {
      const trigger = getTrigger(item);

      item.addEventListener('pointerenter', () => openItem(item));
      item.addEventListener('pointerleave', () => closeItem(item));
      item.addEventListener('focusin', () => openItem(item));
      item.addEventListener('focusout', (event) => {
        if (!item.contains(event.relatedTarget)) closeItem(item);
      });

      // Clic : ouvre/ferme le sous-menu (l'accès à la section se fait via
      // « Voir toute la section » dans le panneau).
      trigger?.addEventListener('click', (event) => {
        event.preventDefault();
        if (item.classList.contains('is-open')) {
          closeItem(item);
        } else {
          openItem(item);
        }
      });
    });

    // Fermer au clic / focus en dehors du menu.
    const closeOnOutside = (event) => {
      if (!nav.contains(event.target)) closeItems();
    };
    document.addEventListener('pointerdown', closeOnOutside);
    document.addEventListener('focusin', (event) => {
      if (!nav.contains(event.target)) closeItems();
    });

    // Navigation clavier : flèches entre sections, ↓ ouvre, ↑ remonte, Échap ferme.
    nav.addEventListener('keydown', (event) => {
      const currentItem = event.target.closest(':scope > ul > li');
      if (!currentItem) return;
      const index = items.indexOf(currentItem);

      if (event.key === 'ArrowRight' || event.key === 'ArrowLeft') {
        event.preventDefault();
        const direction = event.key === 'ArrowRight' ? 1 : -1;
        items[(index + direction + items.length) % items.length]
          ?.querySelector(':scope > a, :scope > button')
          ?.focus();
      }

      if (event.key === 'ArrowDown') {
        const firstLink = currentItem.querySelector('.tds-section-nav__panel a');
        if (firstLink) {
          event.preventDefault();
          openItem(currentItem);
          firstLink.focus();
        }
      }

      if (event.key === 'ArrowUp') {
        const panel = currentItem.querySelector('.tds-section-nav__panel');
        if (panel && panel.contains(document.activeElement)) {
          event.preventDefault();
          closeItem(currentItem);
          getTrigger(currentItem)?.focus();
        }
      }

      if (event.key === 'Escape') {
        event.preventDefault();
        closeItems();
        getTrigger(currentItem)?.focus();
      }
    });
  })();
</script>

<style>
  .tds-section-nav {
    position: fixed;
    z-index: var(--sl-z-index-navbar);
    inset-inline-start: 0;
    inset-block-start: var(--tds-header-height);
    width: 100%;
    height: var(--tds-section-nav-height);
    background-color: var(--sl-color-bg-nav);
    border-bottom: 1px solid var(--sl-color-hairline-shade);
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.06);
    overflow: visible;
  }

  .tds-section-nav__list {
    position: relative;
    display: flex;
    height: 100%;
    list-style: none;
    margin: 0;
    padding: 0 var(--sl-nav-pad-x);
    gap: 0.25rem;
    overflow: visible;
  }

  .tds-section-nav__item {
    position: relative;
    height: 100%;
  }

  .tds-section-nav__link,
  .tds-section-nav__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    height: 100%;
    padding-inline: 0.75rem;
    border: 0;
    border-bottom: 2px solid transparent;
    background: transparent;
    color: var(--sl-color-white);
    font-family: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: inherit;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
  }

  .tds-section-nav__link:hover,
  .tds-section-nav__link:focus-visible,
  .tds-section-nav__btn:hover,
  .tds-section-nav__btn:focus-visible {
    color: var(--sl-color-text-accent);
    background: var(--sl-color-gray-6);
  }

  .tds-section-nav__link[aria-current='page'],
  .tds-section-nav__btn[aria-current='page'] {
    color: var(--sl-color-text-accent);
    border-bottom-color: var(--sl-color-text-accent);
    font-weight: 600;
  }

  .tds-section-nav__caret {
    font-size: 0.7rem;
    opacity: 0.55;
    line-height: 1;
    transition:
      transform 150ms ease,
      opacity 150ms ease;
  }

  .tds-section-nav__item.is-open .tds-section-nav__caret {
    transform: rotate(180deg);
    opacity: 1;
  }

  .tds-section-nav__panel {
    display: none;
    position: absolute;
    inset-inline: 0;
    inset-block-start: 100%;
    padding: 1rem var(--sl-nav-pad-x) 1.25rem;
    background-color: var(--sl-color-bg-nav);
    border-block-end: 1px solid var(--sl-color-hairline-shade);
    box-shadow: 0 12px 28px rgb(0 0 0 / 0.18);
  }

  .tds-section-nav__item:hover > .tds-section-nav__panel,
  .tds-section-nav__item:focus-within > .tds-section-nav__panel,
  .tds-section-nav__item.is-open > .tds-section-nav__panel {
    display: block;
  }

  .tds-section-nav__panel-inner {
    max-width: min(58rem, calc(100vw - 3rem));
    margin-inline: auto;
  }

  .tds-section-nav__panel-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-block-end: 0.625rem;
    border-block-end: 1px solid var(--sl-color-hairline-shade);
  }

  .tds-section-nav__panel-header > span {
    color: var(--sl-color-white);
    font-size: 1.125rem;
    font-weight: 700;
  }

  .tds-section-nav__panel-header > a {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.5rem 0.75rem;
    border-radius: 0.375rem;
    color: var(--sl-color-text-accent);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
  }

  .tds-section-nav__panel-header > a:hover {
    background: var(--sl-color-gray-6);
  }

  .tds-section-nav__columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: 1rem 1.5rem;
    padding-block-start: 0.75rem;
  }

  .tds-section-nav__column {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .tds-section-nav__section-title {
    margin: 0 0 0.375rem;
    color: var(--sl-color-gray-3);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .tds-section-nav__section ul {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tds-section-nav__section a {
    display: flex;
    align-items: center;
    min-height: 1.75rem;
    padding: 0.25rem 0.5rem;
    border-radius: 0.375rem;
    color: var(--sl-color-gray-2);
    font-size: 0.8125rem;
    font-weight: 500;
    text-decoration: none;
  }

  .tds-section-nav__section a:hover,
  .tds-section-nav__section a:focus-visible {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-text-accent);
  }

  .tds-section-nav__section a.is-current {
    background: var(--sl-color-accent-low);
    color: var(--sl-color-text-accent);
    font-weight: 600;
  }

  /* ── Responsive : sous-menus cachés, barre défilable ─────────── */
  @media (max-width: 50rem) {
    .tds-section-nav {
      overflow-x: auto;
    }

    .tds-section-nav__panel {
      display: none !important;
    }

    .tds-section-nav__list {
      overflow-x: auto;
      scrollbar-width: thin;
    }

    .tds-section-nav__link,
    .tds-section-nav__btn {
      padding-inline: 0.625rem;
      font-size: 0.8125rem;
    }
  }
</style>
