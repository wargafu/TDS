---
// Barre horizontale des 10 sections (Premiers pas / Fondamentaux / ...),
// affichée sous le header principal, sur toute la largeur — à la manière
// du DSFR. Rendue par l'override de PageFrame.astro, entre le header et
// la zone à deux colonnes (sidebar scopée + contenu).
import { SECTION_PREFIXES } from './section-prefixes';

// eslint-disable-next-line @typescript-eslint/no-explicit-any
const { sidebar } = (Astro.locals as any).starlightRoute;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const pathname = Astro.url.pathname;

type SectionEntry = {
  type: 'link' | 'group';
  label: string;
  href?: string;
  entries?: SectionEntry[];
};

const groups = sidebar.filter((entry: SectionEntry) => entry.type === 'group') as SectionEntry[];

const getMenuColumns = (entries: SectionEntry[]) => {
  const directLinks = entries.filter((entry) => entry.type === 'link');
  const nestedGroups = entries.filter((entry) => entry.type === 'group');

  return [
    ...(directLinks.length ? [{ label: '', entries: directLinks }] : []),
    ...nestedGroups.map((entry) => ({ label: entry.label, entries: entry.entries ?? [] })),
  ];
};

const activeIndex = groups.findIndex((_group: unknown, i: number) => {
  const prefix = SECTION_PREFIXES[i];
  return prefix && pathname.includes(`/${prefix}/`);
});
---

<nav class="tds-section-nav print:hidden" aria-label="Sections de la documentation">
  <ul>
    {
      groups.map((group, i: number) => {
        const prefix = SECTION_PREFIXES[i];
        const href = `${base}${prefix}/`;
        const isActive = i === activeIndex;
        return (
          <li class:list={{ active: isActive, 'has-menu': Boolean(group.entries?.length) }}>
            <a
              href={href}
              aria-current={isActive ? 'page' : undefined}
              aria-haspopup={group.entries?.length ? 'true' : undefined}
            >
              {group.label}
            </a>
            {
              group.entries?.length && (
                <div class="tds-section-nav__panel" aria-label={`Navigation ${group.label}`}>
                  <div class="tds-section-nav__panel-inner">
                    <div class="tds-section-nav__panel-header">
                      <span>{group.label}</span>
                      <a href={href}>Voir toute la section <span aria-hidden="true">→</span></a>
                    </div>
                    <div class="tds-section-nav__columns">
                      {getMenuColumns(group.entries).map((column) => (
                        <div class="tds-section-nav__column">
                          {column.label && <p>{column.label}</p>}
                          <ul>
                            {column.entries.map(
                              (entry) =>
                                entry.type === 'link' &&
                                entry.href && (
                                  <li>
                                    <a href={entry.href}>{entry.label}</a>
                                  </li>
                                )
                            )}
                          </ul>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              )
            }
          </li>
        );
      })
    }
  </ul>
</nav>

<style>
  .tds-section-nav {
    position: fixed;
    z-index: var(--sl-z-index-navbar);
    inset-inline-start: 0;
    inset-block-start: var(--tds-header-height);
    width: 100%;
    height: var(--tds-section-nav-height);
    background-color: var(--sl-color-bg-nav);
    border-bottom: 1px solid var(--sl-color-hairline-shade);
    overflow: visible;
  }

  .tds-section-nav ul {
    display: flex;
    height: 100%;
    list-style: none;
    margin: 0;
    padding: 0 var(--sl-nav-pad-x);
    gap: 1.5rem;
  }

  .tds-section-nav > ul {
    position: relative;
  }

  .tds-section-nav > ul > li {
    height: 100%;
  }

  .tds-section-nav a {
    display: flex;
    align-items: center;
    height: 100%;
    white-space: nowrap;
    font-size: var(--sl-text-base);
    font-weight: 600;
    text-decoration: none;
    color: var(--sl-color-gray-2);
    border-bottom: 3px solid transparent;
  }

  .tds-section-nav a:hover,
  .tds-section-nav a:focus-visible {
    color: var(--sl-color-white);
  }

  .tds-section-nav a[aria-current='page'] {
    color: var(--sl-color-text-accent);
    border-bottom-color: var(--sl-color-text-accent);
  }

  .tds-section-nav__panel {
    display: none;
    position: absolute;
    inset-inline: 0;
    inset-block-start: 100%;
    padding: 1.25rem var(--sl-nav-pad-x) 1.5rem;
    border-block-end: 1px solid var(--sl-color-hairline-shade);
    background: var(--sl-color-bg-nav);
    box-shadow: 0 1rem 2rem rgb(0 0 0 / 14%);
  }

  .tds-section-nav > ul > li:hover > .tds-section-nav__panel,
  .tds-section-nav > ul > li:focus-within > .tds-section-nav__panel {
    display: block;
  }

  .tds-section-nav__panel-inner {
    max-width: var(--tds-doc-content-width, 68rem);
    margin-inline: auto;
  }

  .tds-section-nav__panel-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-block-end: 0.875rem;
    border-block-end: 1px solid var(--sl-color-gray-5);
  }

  .tds-section-nav__panel-header > span {
    color: var(--sl-color-white);
    font-size: var(--sl-text-lg);
    font-weight: 700;
  }

  .tds-section-nav__panel-header > a {
    height: auto;
    border: 0;
    color: var(--sl-color-text-accent);
    font-size: var(--sl-text-sm);
    font-weight: 600;
  }

  .tds-section-nav__columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: 1.25rem 2rem;
    padding-block-start: 1rem;
  }

  .tds-section-nav__column > p {
    margin: 0 0 0.5rem;
    color: var(--sl-color-text-accent);
    font-size: var(--sl-text-sm);
    font-weight: 700;
  }

  .tds-section-nav__column ul {
    display: flex;
    height: auto;
    flex-direction: column;
    gap: 0.125rem;
    margin: 0;
    padding: 0;
  }

  .tds-section-nav__column a {
    min-height: 2.25rem;
    height: auto;
    padding: 0.375rem 0.5rem;
    border: 0;
    border-radius: 0.375rem;
    font-size: var(--sl-text-sm);
  }

  .tds-section-nav__column a:hover,
  .tds-section-nav__column a:focus-visible {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
  }

  @media (max-width: 50rem) {
    .tds-section-nav {
      overflow-x: auto;
    }

    .tds-section-nav__panel {
      display: none !important;
    }

    .tds-section-nav ul {
      gap: 1rem;
    }
  }
</style>
