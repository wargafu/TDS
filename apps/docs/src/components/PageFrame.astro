---
// Étend le PageFrame Starlight par défaut pour insérer la barre de
// sections (SectionNav) entre le header principal et la zone à deux
// colonnes (sidebar scopée + contenu) — reproduit la structure DSFR.
// Copie fidèle du PageFrame par défaut, seul l'ajout de <SectionNav />
// et les ajustements de hauteur de layout associés changent.
// @ts-expect-error — module virtuel, résolu à l'exécution par Astro/Vite
import MobileMenuToggle from 'virtual:starlight/components/MobileMenuToggle';
import SectionNav from './SectionNav.astro';

// eslint-disable-next-line @typescript-eslint/no-explicit-any
const { hasSidebar } = (Astro.locals as any).starlightRoute;
---

<div class="page sl-flex">
  <header class="header"><slot name="header" /></header>
  <SectionNav />
  {
    hasSidebar && (
      <nav class="sidebar print:hidden" aria-label="Menu latéral">
        <MobileMenuToggle />
        <div id="starlight__sidebar" class="sidebar-pane">
          <div class="sidebar-content sl-flex">
            <slot name="sidebar" />
          </div>
        </div>
      </nav>
    )
  }
  <div class="main-frame"><slot /></div>
</div>

<script is:inline>
  (() => {
    let suppressTabHashUpdate = false;

    const enhanceTabs = () => {
      document.querySelectorAll('starlight-tabs').forEach((tabs) => {
        if (tabs.querySelector('.tds-tabs-heading')) return;

        const heading = document.createElement('p');
        heading.className = 'tds-tabs-heading';
        heading.textContent = 'Explorer ce composant';
        tabs.prepend(heading);
      });
    };

    const getTabPanel = (element) => {
      const panel = element?.closest('[role="tabpanel"]');
      if (!panel || panel.parentElement?.tagName.toLowerCase() !== 'starlight-tabs') return null;
      return panel;
    };

    const findTabForPanel = (panel) => {
      const tabs = panel?.parentElement;
      if (!tabs) return null;

      return [...tabs.querySelectorAll('[role="tab"]')].find(
        (tab) => tab.getAttribute('href') === `#${panel.id}`
      );
    };

    const activatePanel = (panel) => {
      const tab = findTabForPanel(panel);
      if (!tab || tab.getAttribute('aria-selected') === 'true') return;

      suppressTabHashUpdate = true;
      if (tab instanceof HTMLElement) {
        tab.click();
      }
      suppressTabHashUpdate = false;
    };

    const syncTabTableOfContents = () => {
      document.querySelectorAll('starlight-toc a, mobile-starlight-toc a').forEach((link) => {
        const href = link.getAttribute('href');
        if (!href?.startsWith('#')) return;

        const target = document.getElementById(href.slice(1));
        const panel = getTabPanel(target);
        const item = link.closest('li');
        if (!item) return;

        if (panel) {
          item.dataset.tdsTabPanel = panel.id;
        } else {
          delete item.dataset.tdsTabPanel;
        }
      });

      const activePanels = new Set(
        [...document.querySelectorAll('starlight-tabs > [role="tabpanel"]:not([hidden])')].map(
          (panel) => panel.id
        )
      );

      document.querySelectorAll('li[data-tds-tab-panel]').forEach((item) => {
        item.hidden = !activePanels.has(item.dataset.tdsTabPanel);
      });
    };

    const scrollToTarget = (target, panel) => {
      window.requestAnimationFrame(() => {
        if (target === panel) {
          panel.parentElement?.scrollIntoView({ block: 'start' });
        } else {
          target?.scrollIntoView({ block: 'start' });
        }
      });
    };

    const selectTabFromHash = () => {
      const hash = window.location.hash.slice(1);
      if (!hash) return;

      const target = document.getElementById(hash);
      const panel = getTabPanel(target);
      if (!panel) return;

      activatePanel(panel);
      scrollToTarget(target, panel);
      syncTabTableOfContents();
    };

    document.addEventListener(
      'click',
      (event) => {
        if (!(event.target instanceof Element)) return;

        const anchor = event.target.closest('a[href^="#"]');
        if (!(anchor instanceof HTMLAnchorElement)) return;

        const tab = anchor.closest('starlight-tabs [role="tab"]');
        if (tab instanceof HTMLAnchorElement) {
          if (!suppressTabHashUpdate) {
            const tabHash = tab.getAttribute('href');
            if (tabHash) window.history.replaceState(null, '', tabHash);
          }
          window.requestAnimationFrame(syncTabTableOfContents);
          return;
        }

        const hash = anchor.getAttribute('href');
        const target = hash ? document.getElementById(hash.slice(1)) : null;
        const panel = getTabPanel(target);
        if (!hash || !target || !panel) return;

        event.preventDefault();
        activatePanel(panel);
        window.history.pushState(null, '', hash);
        scrollToTarget(target, panel);
        window.requestAnimationFrame(syncTabTableOfContents);
      },
      true
    );

    window.addEventListener('hashchange', selectTabFromHash);
    window.addEventListener('DOMContentLoaded', () => {
      enhanceTabs();
      syncTabTableOfContents();
      selectTabFromHash();
    });
  })();
</script>

<style>
  .page {
    flex-direction: column;
    min-height: 100vh;
  }

  .header {
    z-index: var(--sl-z-index-navbar);
    position: fixed;
    inset-inline-start: 0;
    inset-block-start: 0;
    width: 100%;
    height: var(--tds-header-height);
    border-bottom: 1px solid var(--sl-color-hairline-shade);
    padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
    padding-inline-end: var(--sl-nav-pad-x);
    background-color: var(--sl-color-bg-nav);
  }

  :global([data-has-sidebar]) .header {
    padding-inline-end: calc(var(--sl-nav-gap) + var(--sl-nav-pad-x) + var(--sl-menu-button-size));
  }

  .sidebar-pane {
    visibility: var(--sl-sidebar-visibility, hidden);
    position: fixed;
    z-index: var(--sl-z-index-menu);
    inset-block: var(--sl-nav-height) 0;
    inset-inline-start: 0;
    width: 100%;
    background-color: var(--sl-color-black);
    overflow-y: auto;
  }

  :global([aria-expanded='true']) ~ .sidebar-pane {
    --sl-sidebar-visibility: visible;
  }

  .sidebar-content {
    height: 100%;
    min-height: max-content;
    padding: 1rem var(--sl-sidebar-pad-x) 0;
    flex-direction: column;
    gap: 1rem;
  }

  @media (min-width: 50rem) {
    .sidebar-content::after {
      content: '';
      padding-bottom: 1px;
    }
  }

  .main-frame {
    padding-top: calc(var(--sl-nav-height) + var(--sl-mobile-toc-height));
    padding-inline-start: var(--sl-content-inline-start);
  }

  @media (min-width: 50rem) {
    :global([data-has-sidebar]) .header {
      padding-inline-end: var(--sl-nav-pad-x);
    }
    .sidebar-pane {
      --sl-sidebar-visibility: visible;
      width: var(--sl-sidebar-width);
      background-color: var(--sl-color-bg-sidebar);
      border-inline-end: 1px solid var(--sl-color-hairline-shade);
    }
  }
</style>
