---
import { sectionForSlug } from '../lib/navigation';
import SidebarList from './SidebarList.astro';

interface Props {
  activeSlug: string;
}
const { activeSlug } = Astro.props;
const section = sectionForSlug(activeSlug);
---

{
  section && (
    <nav class="sidebar" aria-label={`Navigation — ${section.label}`}>
      <p class="sidebar__title">{section.label}</p>
      <SidebarList items={section.items} activeSlug={activeSlug} />
    </nav>
  )
}
