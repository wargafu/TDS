---
// Remplace le sélecteur clair/sombre/auto de Starlight (menu déroulant) par
// un simple bouton bascule à deux états, sur le modèle des design systèmes
// gouvernementaux de référence (DSBJ, DSFR) — un seul geste, pas de menu.
---

<theme-toggle>
  <button type="button" aria-label="Activer le thème sombre">
    <svg class="icon-sun" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
      <path d="M5 12a1 1 0 0 0-1-1H3a1 1 0 0 0 0 2h1a1 1 0 0 0 1-1Zm.64 5-.71.71a1 1 0 0 0 0 1.41 1 1 0 0 0 1.41 0l.71-.71A1 1 0 0 0 5.64 17ZM12 5a1 1 0 0 0 1-1V3a1 1 0 0 0-2 0v1a1 1 0 0 0 1 1Zm5.66 2.34a1 1 0 0 0 .7-.29l.71-.71a1 1 0 1 0-1.41-1.41l-.66.71a1 1 0 0 0 0 1.41 1 1 0 0 0 .66.29Zm-12-.29a1 1 0 0 0 1.41 0 1 1 0 0 0 0-1.41l-.71-.71a1.004 1.004 0 1 0-1.43 1.41l.73.71ZM21 11h-1a1 1 0 0 0 0 2h1a1 1 0 0 0 0-2Zm-2.64 6A1 1 0 0 0 17 18.36l.71.71a1 1 0 0 0 1.41 0 1 1 0 0 0 0-1.41l-.76-.66ZM12 6.5a5.5 5.5 0 1 0 5.5 5.5A5.51 5.51 0 0 0 12 6.5Zm0 9a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7Zm0 3.5a1 1 0 0 0-1 1v1a1 1 0 0 0 2 0v-1a1 1 0 0 0-1-1Z"></path>
    </svg>
    <svg class="icon-moon" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
      <path d="M21.64 13a1 1 0 0 0-1.05-.14 8.049 8.049 0 0 1-3.37.73 8.15 8.15 0 0 1-8.14-8.1 8.59 8.59 0 0 1 .25-2A1 1 0 0 0 8 2.36a10.14 10.14 0 1 0 14 11.69 1 1 0 0 0-.36-1.05Zm-9.5 6.69A8.14 8.14 0 0 1 7.08 5.22v.27a10.15 10.15 0 0 0 10.14 10.14 9.784 9.784 0 0 0 2.1-.22 8.11 8.11 0 0 1-7.18 4.32v-.04Z"></path>
    </svg>
  </button>
</theme-toggle>

<script is:inline>
  (() => {
    const storageKey = 'starlight-theme';
    const getPreferred = () => 'light';
    const load = () => {
      const stored = typeof localStorage !== 'undefined' ? localStorage.getItem(storageKey) : null;
      return stored === 'light' || stored === 'dark' ? stored : getPreferred();
    };
    window.__tdsApplyTheme = (theme) => {
      document.documentElement.dataset.theme = theme;
      if (typeof localStorage !== 'undefined') localStorage.setItem(storageKey, theme);
      document
        .querySelectorAll('theme-toggle button')
        .forEach((btn) => btn.setAttribute('aria-label', theme === 'dark' ? 'Activer le thème clair' : 'Activer le thème sombre'));
    };
    window.__tdsApplyTheme(load());
  })();
</script>

<script>
  class ThemeToggle extends HTMLElement {
    constructor() {
      super();
      this.querySelector('button')?.addEventListener('click', () => {
        const current = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
        // @ts-expect-error — défini par le script inline ci-dessus
        window.__tdsApplyTheme(current === 'dark' ? 'light' : 'dark');
      });
    }
  }
  customElements.define('theme-toggle', ThemeToggle);
</script>

<style>
  theme-toggle button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    background: transparent;
    border: none;
    border-radius: 999px;
    color: var(--sl-color-gray-2);
    cursor: pointer;
  }
  theme-toggle button:hover {
    color: var(--sl-color-white);
    background: var(--sl-color-gray-6);
  }
  :root[data-theme='light'] theme-toggle button:hover {
    background: var(--sl-color-gray-6);
  }

  .icon-moon { display: none; }
  :root[data-theme='light'] .icon-moon { display: block; }
  :root[data-theme='light'] .icon-sun { display: none; }
</style>
