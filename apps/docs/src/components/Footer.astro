---
// Pied de page institutionnel classique et épuré :
//   brand + tagline (gauche) · colonnes de liens (droite) · légal + copyright (bas)
// Fond adapté au thème, aligné sur la colonne de contenu de la page.
import Default from '@astrojs/starlight/components/Footer.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const columns = [
  {
    label: 'Ressources',
    links: [
      { label: 'Documentation', href: '' },
      { label: 'Composants', href: 'components/' },
      { label: 'Dépôt GitHub', href: 'https://github.com/kisaigo/TDGS', external: true },
      { label: 'Feuille de route', href: 'communaute/roadmap/' },
    ],
  },
  {
    label: 'Communauté',
    links: [
      { label: 'Contribution', href: 'communaute/contribution/' },
      { label: 'Support', href: 'aide/faq/' },
      { label: 'Statut du projet', href: 'about/statut/' },
    ],
  },
];

const legalLinks = [
  { label: 'Accessibilité : non conforme', href: 'about/accessibilite/' },
  { label: 'Conditions générales d\'utilisation', href: 'about/cgu/' },
  { label: 'Mentions légales', href: 'about/mentions-legales/' },
  { label: 'Plan du site', href: 'about/plan-du-site/' },
  { label: 'Gestion des cookies', href: 'about/cookies/' },
  { label: 'Paramètres d\'affichage', href: 'about/parametres-affichage/' },
];

const year = new Date().getFullYear();
---

<Default><slot /></Default>

<footer class="tds-institutional-footer" role="contentinfo">
  <div class="tds-institutional-footer__container">
    <div class="tds-institutional-footer__main">
      <div class="tds-institutional-footer__brand">
        <a class="tds-institutional-footer__brand-link" href={base} aria-label="TDGS — accueil">
          <img src={`${base}brand/tdgs-mark.svg`} alt="" width="48" height="48" loading="lazy" />
          <span class="tds-institutional-footer__brand-name">
            <strong>TDGS</strong>
            <span>Tchad Design System</span>
          </span>
        </a>
        <p class="tds-institutional-footer__tagline">
          Système de design open source proposé pour les services numériques publics du Tchad.
        </p>
        <p class="tds-institutional-footer__notice">
          Initiative indépendante et communautaire. TDGS ne revendique pas d'homologation
          officielle de l'État ni l'usage de ses symboles.
        </p>
      </div>

      <nav class="tds-institutional-footer__columns" aria-label="Liens du pied de page">
        {columns.map((col) => (
          <div class="tds-institutional-footer__column">
            <h2>{col.label}</h2>
            <ul>
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.external ? link.href : `${base}${link.href}`}
                    target={link.external ? '_blank' : undefined}
                    rel={link.external ? 'noopener noreferrer' : undefined}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </div>

    <div class="tds-institutional-footer__bottom">
      <ul class="tds-institutional-footer__legal">
        {legalLinks.map((link) => (
          <li><a href={`${base}${link.href}`}>{link.label}</a></li>
        ))}
      </ul>
      <p class="tds-institutional-footer__copyright">
        © {year} contributeurs TDGS — MIT
      </p>
    </div>
  </div>
</footer>

<style>
  .tds-institutional-footer {
    position: relative;
    width: 100vw;
    margin: 5rem calc(-1 * var(--sl-content-pad-x)) -1.5rem;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
  }

  :global(html[data-has-sidebar]) .tds-institutional-footer {
    margin-inline-start: calc(-1 * (var(--sl-content-inline-start) + var(--sl-content-pad-x)));
    margin-inline-end: calc(-1 * var(--sl-content-pad-x));
  }

  /* Liseré tricolore TDGS, fin et discret. */
  .tds-institutional-footer::before {
    content: '';
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    height: 0.25rem;
    background: linear-gradient(
      to right,
      var(--tds-brand-blue) 0 33.33%,
      var(--tds-brand-yellow) 33.33% 66.66%,
      var(--tds-brand-red) 66.66% 100%
    );
  }

  /* Conteneur pleine largeur, contenu aligné sur la colonne de la page. */
  .tds-institutional-footer__container {
    max-width: var(--sl-content-width);
    margin-inline: 0;
    padding-inline: var(--sl-content-pad-x);
  }

  :global(html[data-has-sidebar]) .tds-institutional-footer__container {
    padding-inline-start: calc(var(--sl-content-inline-start) + var(--sl-content-pad-x));
  }

  /* ── Zone principale : marque à gauche, colonnes à droite ────── */
  .tds-institutional-footer__main {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2.5rem 3.5rem;
    padding-block: 3rem 2.5rem;
  }

  .tds-institutional-footer__brand {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    max-width: 22rem;
  }

  .tds-institutional-footer__brand-link {
    display: inline-flex;
    align-items: center;
    gap: 0.875rem;
    width: fit-content;
    text-decoration: none;
  }

  .tds-institutional-footer__brand img {
    width: 3.75rem;
    height: auto;
    max-height: 3.75rem;
    object-fit: contain;
    flex-shrink: 0;
  }

  .tds-institutional-footer__brand-name {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .tds-institutional-footer__brand-name strong {
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    color: var(--sl-color-white);
  }

  .tds-institutional-footer__brand-name > span {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }

  .tds-institutional-footer__tagline {
    margin: 0;
    font-size: var(--sl-text-sm);
    line-height: 1.5;
    color: var(--sl-color-gray-3);
  }

  .tds-institutional-footer__notice {
    margin: 0.375rem 0 0;
    font-size: var(--sl-text-xs);
    line-height: 1.4;
    color: var(--sl-color-gray-4);
  }

  .tds-institutional-footer__columns {
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem 4rem;
  }

  .tds-institutional-footer__column h2 {
    margin: 0 0 0.875rem;
    font-size: var(--sl-text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }

  .tds-institutional-footer__column ul {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tds-institutional-footer__column a {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
    text-decoration: none;
    text-underline-offset: 0.25rem;
  }

  .tds-institutional-footer__column a:hover,
  .tds-institutional-footer__column a:focus-visible {
    color: var(--sl-color-white);
    text-decoration: underline;
    text-decoration-color: var(--tds-brand-yellow);
  }

  /* ── Barre du bas : légal + copyright ────────────────────────── */
  .tds-institutional-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--sl-color-gray-5);
  }

  .tds-institutional-footer__legal {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tds-institutional-footer__legal li + li {
    border-inline-start: 1px solid var(--sl-color-gray-5);
    margin-inline-start: 1rem;
    padding-inline-start: 1rem;
  }

  .tds-institutional-footer__legal a {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-4);
    text-decoration: none;
    text-underline-offset: 0.25rem;
  }

  .tds-institutional-footer__legal a:hover,
  .tds-institutional-footer__legal a:focus-visible {
    color: var(--sl-color-white);
    text-decoration: underline;
  }

  .tds-institutional-footer__copyright {
    margin: 0;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-4);
  }

  /* ── Responsive ──────────────────────────────────────────────── */
  @media (max-width: 45rem) {
    .tds-institutional-footer__main {
      flex-direction: column;
      gap: 2rem;
    }
  }
</style>
