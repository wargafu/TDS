---
// Étend le Footer Starlight par défaut avec un bandeau de ressources TDGS :
// identité du projet + ressources + informations légales, en colonnes.
import Default from '@astrojs/starlight/components/Footer.astro';

const base = import.meta.env.BASE_URL;

const resourceLinks = [
  { label: 'Documentation', href: '' },
  { label: 'Composants', href: 'components/' },
  { label: 'Dépôt GitHub', href: 'https://github.com/wargafu/TDGS', external: true },
  { label: 'Feuille de route', href: 'communaute/roadmap/' },
];

const legalLinks = [
  { label: 'Accessibilité : non conforme', href: 'about/accessibilite/' },
  { label: 'Conditions générales d\'utilisation', href: 'about/cgu/' },
  { label: 'Mentions légales', href: 'about/mentions-legales/' },
  { label: 'Plan du site', href: 'about/plan-du-site/' },
  { label: 'Gestion des cookies', href: 'about/cookies/' },
  { label: 'Paramètres d\'affichage', href: 'about/parametres-affichage/' },
];

const year = new Date().getFullYear();
---

<Default><slot /></Default>

<div class="tds-institutional-footer">
  <div class="tds-institutional-footer__grid">
    <div class="tds-institutional-footer__brand">
      <img src={`${base}brand/tdgs-logo.png`} alt="" width="40" height="40" />
      <div>
        <p class="tds-institutional-footer__country">TDGS — Tchad Design System</p>
        <p class="tds-institutional-footer__motto">Proposition open source pour les services publics du Tchad</p>
      </div>
    </div>

    <nav aria-label="Ressources">
      <p class="tds-institutional-footer__heading">Ressources</p>
      <ul>
        {resourceLinks.map((link) => (
          <li>
            <a
              href={link.external ? link.href : `${base}${link.href}`}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener noreferrer' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <nav aria-label="Informations légales">
      <p class="tds-institutional-footer__heading">Informations légales</p>
      <ul>
        {legalLinks.map((link) => (
          <li><a href={`${base}${link.href}`}>{link.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>

  <div class="tds-institutional-footer__bottom">
    <p>© {year} contributeurs TDGS — projet open source sous licence MIT.</p>
  </div>
</div>

<style>
  .tds-institutional-footer {
    border-top: 1px solid var(--sl-color-gray-5);
    padding-block: 2rem 1.25rem;
  }

  .tds-institutional-footer__grid {
    max-width: var(--sl-content-width);
    margin-inline: auto;
    padding-inline: 1.5rem;
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 2rem;
  }

  @media (max-width: 45rem) {
    .tds-institutional-footer__grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }

  .tds-institutional-footer__brand {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .tds-institutional-footer__brand img {
    border-radius: 6px;
    flex-shrink: 0;
  }

  .tds-institutional-footer__country {
    margin: 0;
    font-size: var(--sl-text-sm);
    font-weight: 700;
    color: var(--sl-color-white);
  }

  .tds-institutional-footer__motto {
    margin: 0.125rem 0 0;
    font-size: var(--sl-text-xs);
    font-style: italic;
    color: var(--sl-color-gray-3);
  }

  .tds-institutional-footer__heading {
    margin: 0 0 0.625rem;
    font-size: var(--sl-text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--sl-color-gray-4);
  }

  .tds-institutional-footer ul {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tds-institutional-footer a {
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
    text-decoration: none;
  }

  .tds-institutional-footer a:hover {
    color: var(--sl-color-white);
    text-decoration: underline;
  }

  .tds-institutional-footer__bottom {
    max-width: var(--sl-content-width);
    margin-inline: auto;
    padding-inline: 1.5rem;
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--sl-color-gray-6);
  }

  .tds-institutional-footer__bottom p {
    margin: 0;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-4);
  }
</style>
