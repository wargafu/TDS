{
  "name": "tds-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-core-assets.mjs && astro dev",
    "build": "node scripts/copy-core-assets.mjs && astro build && node scripts/prefix-dist-links.mjs",
    "gen:brand": "node scripts/generate-brand-rasters.mjs",
    "preview": "astro preview",
    "check:performance": "node scripts/check-performance.mjs",
    "check:links": "node scripts/check-links.mjs",
    "typecheck": "astro check",
    "test:a11y": "start-server-and-test \"astro preview --host 127.0.0.1 --port 4322\" http://127.0.0.1:4322 \"node scripts/test-a11y.mjs http://127.0.0.1:4322/playground/\""
  },
  "dependencies": {
    "@astrojs/starlight": "^0.32.0",
    "astro": "^5.0.0",
    "sharp": "^0.33.0"
  },
  "devDependencies": {
    "@tdgs/core": "workspace:*",
    "@astrojs/check": "^0.9.0",
    "axe-core": "^4.12.1",
    "puppeteer": "^25.3.0",
    "start-server-and-test": "^3.0.11",
    "typescript": "^5.6.0"
  }
}
