{
  "name": "tds-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-core-assets.mjs && astro dev",
    "build": "node scripts/copy-core-assets.mjs && astro build && pagefind --site dist && node scripts/prefix-dist-links.mjs",
    "gen:brand": "node scripts/generate-brand-rasters.mjs",
    "preview": "astro preview",
    "check:performance": "node scripts/check-performance.mjs",
    "check:links": "node scripts/check-links.mjs",
    "typecheck": "astro check",
    "test:a11y": "start-server-and-test \"astro preview --host 127.0.0.1 --port 4322\" http://127.0.0.1:4322 \"node scripts/test-a11y.mjs http://127.0.0.1:4322\"",
    "test:a11y:templates": "node scripts/test-a11y-templates.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.0",
    "@astrojs/sitemap": "^3.2.0",
    "@fontsource-variable/source-sans-3": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.0",
    "@fontsource/noto-naskh-arabic": "^5.1.0",
    "astro": "^5.0.0",
    "astro-expressive-code": "^0.44.2",
    "sharp": "^0.33.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@tdgs/core": "workspace:*",
    "axe-core": "^4.12.1",
    "pagefind": "^1.5.2",
    "puppeteer": "^25.3.0",
    "start-server-and-test": "^3.0.11",
    "typescript": "^5.6.0",
    "unist-util-visit": "^5.1.0"
  }
}
